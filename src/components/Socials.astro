<ul class:list={['socials', cls]} aria-label="Social media">
  {LINKS.socials.map((s) => (
    <li>
      <a href={s.url} rel="me noopener" target="_blank" aria-label={s.label} title={s.label} data-id={s.id}>
        {s.id === 'instagram' ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[s.id]} /></svg>
        )}
      </a>
    </li>
  ))}
</ul>
