---
import Base from '../layouts/Base.astro';
import Recommend from '../components/Recommend.astro';
import { PAGES, PATHS, UI, SITE, TOOL_URL, LOL_LAYOUT_META, urlFor, type Lang, type PageId } from '../content';

export function getStaticPaths() {
  const out: { params: { slug: string | undefined }; props: { lang: Lang; id: PageId } }[] = [];
  (['pl', 'en'] as Lang[]).forEach((lang) => {
    (Object.keys(PAGES[lang]) as PageId[]).forEach((id) => {
      const path = (lang === 'en' ? 'en/' : '') + PATHS[id][lang];
      out.push({ params: { slug: path.replace(/\/$/, '') || undefined }, props: { lang, id } });
    });
  });
  return out;
}

const { lang, id } = Astro.props as { lang: Lang; id: PageId };
const page = PAGES[lang][id];
const ui = UI[lang];
const url = SITE + urlFor(id, lang);

const jsonLd: object[] = [];
if (id === 'home') {
  jsonLd.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'VXH – Visual eXtras Hub', url: SITE + '/', inLanguage: lang });
} else {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.breadcrumbHome, item: SITE + urlFor('home', lang) },
      { '@type': 'ListItem', position: 2, name: page.h1, item: url },
    ],
  });
}
if (page.app) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: page.app === 'faceit' ? 'FACEIT Banner Studio' : 'LoL Banner Studio',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    url: page.app === 'faceit' ? TOOL_URL.faceit : TOOL_URL.lol,
    description: page.description,
    inLanguage: lang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  });
}
if (id === 'livedelay') {
  const shared = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Windows 10, Windows 11',
    description: page.description,
    inLanguage: ['pl', 'en', 'de', 'ru'],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  };
  jsonLd.push({
    ...shared,
    name: 'LiveDelay (OBS plugin)',
    applicationSubCategory: 'OBS Studio plugin',
    url: lang === 'en' ? TOOL_URL.livedelayEn : TOOL_URL.livedelay,
    downloadUrl: TOOL_URL.livedelayDownload,
    codeRepository: TOOL_URL.livedelayRepo,
  });
  jsonLd.push({
    ...shared,
    name: 'LiveDelay (app)',
    applicationSubCategory: 'Standalone stream delay and multistream app',
    url: lang === 'en' ? TOOL_URL.livedelayAppEn : TOOL_URL.livedelayApp,
    downloadUrl: TOOL_URL.livedelayAppDownload,
    codeRepository: TOOL_URL.livedelayAppRepo,
    softwareVersion: '0.1.0',
  });
}
if (id === 'intmouse') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'INTmouse',
    applicationCategory: 'UtilitiesApplication',
    applicationSubCategory: 'Mouse and keyboard sharing',
    operatingSystem: 'Windows 10, Windows 11',
    description: page.description,
    inLanguage: ['pl', 'en'],
    url: TOOL_URL.intmouse,
    downloadUrl: TOOL_URL.intmouseDownload,
    codeRepository: TOOL_URL.intmouseRepo,
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'PLN' },
      { '@type': 'Offer', name: 'Pro month', price: '9.99', priceCurrency: 'PLN' },
      { '@type': 'Offer', name: 'Pro year', price: '89', priceCurrency: 'PLN' },
    ],
  });
}
if (id === 'overlays') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'VXH Overlays',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'OBS Browser Source overlays',
    operatingSystem: 'Web',
    description: page.description,
    inLanguage: 'pl',
    url: TOOL_URL.overlays,
    codeRepository: TOOL_URL.overlaysRepo,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  });
}
const WEB_APPS: Partial<Record<PageId, { name: string; cat: string; sub: string; url: string; repo?: string }>> = {
  pliki: { name: 'pliki.vxh.pl', cat: 'UtilitiesApplication', sub: 'LAN file transfer (WebRTC P2P)', url: TOOL_URL.pliki, repo: TOOL_URL.plikiRepo },
  chat: { name: 'chat.vxh.pl', cat: 'CommunicationApplication', sub: 'End-to-end encrypted chat rooms', url: TOOL_URL.chat, repo: TOOL_URL.chatRepo },
  fpsblindtest: { name: 'FPS Blind Test', cat: 'UtilitiesApplication', sub: 'Frame rate perception test', url: TOOL_URL.fpsblindtest },
};
const webApp = WEB_APPS[id];
if (webApp) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: webApp.name,
    applicationCategory: webApp.cat,
    applicationSubCategory: webApp.sub,
    operatingSystem: 'Web',
    description: page.description,
    inLanguage: ['pl', 'en'],
    url: webApp.url,
    ...(webApp.repo ? { codeRepository: webApp.repo } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  });
}
if (page.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const steps = page.sections?.find((s) => s.ol)?.ol ?? [];
if (page.kind === 'article' && !page.app && steps.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: page.h1,
    description: page.description,
    step: steps.map((t) => ({ '@type': 'HowToStep', text: t })),
  });
}

const tools = [
  { id: 'faceit' as const, name: 'FACEIT Banner Studio', img: '/img/faceit-preview.webp', c: '#ff5900', hover: '#ff7424', tag: 'CS2', href: TOOL_URL.faceit, more: urlFor('faceit', lang) },
  { id: 'overlays' as const, name: 'VXH Overlays', img: '/img/overlays-preview.webp', c: '#a855f7', hover: '#b977f9', tag: 'Browser Source', href: TOOL_URL.overlays, more: urlFor('overlays', lang) },
  { id: 'lol' as const, name: 'LoL Banner Studio', img: '/img/lol-preview.webp', c: '#eb3d4d', hover: '#f25a68', tag: 'League of Legends', href: TOOL_URL.lol, more: urlFor('lol', lang) },
  { id: 'livedelay' as const, name: 'LiveDelay', img: '/img/livedelay-preview.webp', c: '#ff3b2f', hover: '#ff5a4f', tag: lang === 'pl' ? 'Wtyczka OBS + aplikacja' : 'OBS plugin + app', href: lang === 'en' ? TOOL_URL.livedelayEn : TOOL_URL.livedelay, more: urlFor('livedelay', lang) },
  { id: 'intmouse' as const, name: 'INTmouse', img: '/img/intmouse-preview.webp', c: '#7dd3fc', hover: '#a5e4fd', tag: lang === 'pl' ? 'Multi-PC input' : 'Multi-PC input', href: TOOL_URL.intmouse, more: urlFor('intmouse', lang) },
  { id: 'pliki' as const, name: 'pliki.vxh.pl', img: '/img/pliki-preview.webp', c: '#22c55e', hover: '#4ade80', tag: lang === 'pl' ? 'Pliki przez WiFi' : 'Files over WiFi', href: TOOL_URL.pliki, more: urlFor('pliki', lang) },
  { id: 'chat' as const, name: 'chat.vxh.pl', img: '/img/chat-preview.webp', c: '#8b5cf6', hover: '#a78bfa', tag: lang === 'pl' ? 'Czat E2E' : 'E2E chat', href: TOOL_URL.chat, more: urlFor('chat', lang) },
  { id: 'fpsblindtest' as const, name: 'FPS Blind Test', img: '/img/fpsblindtest-preview.webp', c: '#22d3ee', hover: '#67e8f9', tag: lang === 'pl' ? 'Test monitora' : 'Monitor test', href: lang === 'en' ? TOOL_URL.fpsblindtestEn : TOOL_URL.fpsblindtest, more: urlFor('fpsblindtest', lang) },
];
// Main streaming tools get the big cards; the rest has its own section under the recommendation.
const OTHER_TOOLS = ['pliki', 'chat', 'fpsblindtest'];
const mainTools = tools.filter((t) => !OTHER_TOOLS.includes(t.id));
const otherTools = tools.filter((t) => OTHER_TOOLS.includes(t.id));
const toolDesc = {
  faceit: { pl: 'ELO, level i statystyki CS2. 18 układów solo i 13 układów VERSUS.', en: 'ELO, level and CS2 stats. 18 solo and 13 VERSUS layouts.' },
  overlays: { pl: 'Ekrany startu, BRB i końca, efekty, ramki na kamerkę i paski. Ustawienia w linku, bez konta.', en: 'Starting soon, BRB and ending screens, effects, webcam frames and tickers. Settings in the link, no account.' },
  lol: { pl: 'Ranga Solo/Duo i Flex, LP i winrate z Riot ID. 8 układów.', en: 'Solo/Duo and Flex rank, LP and win rate from your Riot ID. 8 layouts.' },
  livedelay: { pl: 'Wtyczka OBS i aplikacja. Delay Arm → Activate → Cut bez reconnecta i lokalny multistream.', en: 'OBS plugin and app. Delay Arm → Activate → Cut without reconnecting, and local multistream.' },
  intmouse: { pl: 'Jedna mysz i klawiatura na kilku PC w LAN. Schowek, pliki, hasło.', en: 'One mouse and keyboard across PCs on your LAN. Clipboard, files, password.' },
  pliki: { pl: 'Pliki między telefonem a komputerem w tej samej WiFi. P2P, bez aplikacji i bez chmury.', en: 'Files between phone and computer on the same WiFi. Peer-to-peer, no app, no cloud.' },
  chat: { pl: 'Prywatne pokoje na hasło z szyfrowaniem E2E. Bez konta, wiadomości nie są zapisywane.', en: 'Private password rooms with end-to-end encryption. No account, messages are not stored.' },
  fpsblindtest: { pl: 'Ślepy test płynności: zgadnij FPS albo wybierz płynniejszą animację. Także w 3D.', en: 'Blind smoothness test: guess the FPS or pick the smoother animation. 3D modes too.' },
};
const toolCta = {
  faceit: ui.openTool,
  overlays: lang === 'pl' ? 'Otwórz studio' : 'Open the studio',
  lol: ui.openTool,
  livedelay: lang === 'pl' ? 'Otwórz livedelay.vxh.pl' : 'Open livedelay.vxh.pl',
  intmouse: lang === 'pl' ? 'Otwórz intmouse.vxh.pl' : 'Open intmouse.vxh.pl',
  pliki: lang === 'pl' ? 'Wyślij plik' : 'Send a file',
  chat: lang === 'pl' ? 'Otwórz czat' : 'Open the chat',
  fpsblindtest: lang === 'pl' ? 'Zacznij test' : 'Start the test',
};
const heroH1 = id === 'home' ? (lang === 'pl' ? 'Banery na Twój stream' : 'Banners for your stream') : page.h1;
const shot = page.app === 'faceit' ? '/img/faceit-generator.webp' : page.app === 'lol' ? '/img/lol-generator.webp' : id === 'livedelay' ? '/img/livedelay-overlay.png' : id === 'intmouse' ? '/img/intmouse-ui.png' : id === 'overlays' ? '/img/overlays-studio.webp' : id === 'pliki' || id === 'chat' || id === 'fpsblindtest' ? `/img/${id}-site.webp` : undefined;
const shotUrl = page.app === 'faceit' ? 'faceitbanner.vxh.pl' : page.app === 'lol' ? 'lolbanner.vxh.pl' : id === 'livedelay' ? 'livedelay.vxh.pl' : id === 'intmouse' ? 'intmouse.vxh.pl' : id === 'overlays' ? 'overlays.vxh.pl' : id === 'pliki' ? 'pliki.vxh.pl' : id === 'chat' ? 'chat.vxh.pl' : id === 'fpsblindtest' ? 'fpsblindtest.vxh.pl' : '';
const shotAlt = page.app === 'faceit'
  ? (lang === 'pl' ? 'Generator FACEIT Banner Studio z podglądem na żywo' : 'FACEIT Banner Studio generator with live preview')
  : page.app === 'lol'
    ? (lang === 'pl' ? 'Generator LoL Banner Studio z podglądem na żywo' : 'LoL Banner Studio generator with live preview')
    : id === 'intmouse'
      ? (lang === 'pl' ? 'INTmouse - wspólna mysz na kilku komputerach' : 'INTmouse - shared mouse across several PCs')
      : id === 'overlays'
        ? (lang === 'pl' ? 'Studio VXH Overlays z podglądem ekranu Zaraz startujemy i panelem ustawień' : 'VXH Overlays studio with a starting soon screen preview and the settings panel')
      : id === 'pliki'
        ? (lang === 'pl' ? 'pliki.vxh.pl: ekran wysyłania pliku z listą urządzeń w sieci' : 'pliki.vxh.pl: the send screen with the list of devices on the network')
      : id === 'chat'
        ? (lang === 'pl' ? 'chat.vxh.pl: ekran wejścia z nickiem i avatarem' : 'chat.vxh.pl: the entry screen with nickname and avatar')
      : id === 'fpsblindtest'
        ? (lang === 'pl' ? 'FPS Blind Test: wykryte odświeżanie monitora i wybór trybu testu' : 'FPS Blind Test: detected refresh rate and test mode picker')
      : (lang === 'pl' ? 'Edytor wyglądu overlayu LiveDelay' : 'LiveDelay overlay appearance editor');
---
<Base lang={lang} id={id} title={page.title} description={page.description} crumb={page.h1} jsonLd={jsonLd}>
  <article>
    <header class="heading">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{heroH1}<em>.</em></h1>
      <p class="lead">{page.lead}</p>
      {page.cta && (
        <div class="btns">
          {page.cta.map((c, i) => <a class:list={['cta', i > 0 && 'alt']} href={c.href}>{c.label}</a>)}
        </div>
      )}
    </header>

    {id === 'home' && (
      <>
        <div class="hero-shots">
          <figure class="shot f">
            <img src="/img/faceit-preview.webp" alt={lang === 'pl' ? 'Baner FACEIT z ELO i statystykami CS2 w podglądzie generatora' : 'FACEIT banner with ELO and CS2 stats in the generator preview'} width="1000" height="490" fetchpriority="high" />
            <figcaption>FACEIT</figcaption>
          </figure>
          <figure class="shot l">
            <img src="/img/lol-preview.webp" alt={lang === 'pl' ? 'Baner rangi League of Legends w podglądzie generatora' : 'League of Legends rank banner in the generator preview'} width="1000" height="530" fetchpriority="high" />
            <figcaption>League of Legends</figcaption>
          </figure>
        </div>
        <div class="cards">
          {mainTools.map((t) => (
            <article class="card" style={`--c:${t.c}`}>
              <div class="img"><img src={t.img} alt="" width="1000" height="500" loading="lazy" /></div>
              <div class="body">
                <span class="tag">{t.tag}</span>
                <h3>{t.name}</h3>
                <p>{toolDesc[t.id][lang]}</p>
                <div class="btns">
                  <a class="cta" style={`--btn:${t.c};--btn-h:${t.hover};--btn-text:${t.id === 'intmouse' || t.id === 'pliki' || t.id === 'fpsblindtest' ? '#0b0e13' : '#fff'}`} href={t.href} rel={t.id === 'faceit' || t.id === 'lol' ? undefined : 'noopener'}>{toolCta[t.id]}</a>
                  <a class="cta alt" href={t.more}>{lang === 'pl' ? 'Dowiedz się więcej' : 'Learn more'}</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {id === 'home' && <Recommend lang={lang} />}

    {id === 'home' && (
      <section class="more-tools" aria-labelledby="more-tools-h">
        <div class="sect-head"><h2 id="more-tools-h">{lang === 'pl' ? 'Inne narzędzia' : 'More tools'}</h2><small>{otherTools.length}</small></div>
        <p class="more-lead">{lang === 'pl' ? 'Darmowe narzędzia w przeglądarce od tego samego autora: pliki przez WiFi, prywatny czat i test płynności monitora.' : 'Free browser tools from the same author: files over WiFi, private chat and a monitor smoothness test.'}</p>
        <div class="cards cards-sm">
          {otherTools.map((t) => (
            <article class="card" style={`--c:${t.c}`}>
              <div class="img"><img src={t.img} alt="" width="1000" height="500" loading="lazy" /></div>
              <div class="body">
                <span class="tag">{t.tag}</span>
                <h3>{t.name}</h3>
                <p>{toolDesc[t.id][lang]}</p>
                <div class="btns">
                  <a class="cta" style={`--btn:${t.c};--btn-h:${t.hover};--btn-text:${t.id === 'chat' ? '#fff' : '#0b0e13'}`} href={t.href} rel="noopener">{toolCta[t.id]}</a>
                  <a class="cta alt" href={t.more}>{lang === 'pl' ? 'Dowiedz się więcej' : 'Learn more'}</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {shot && (
      <div class="window">
        <div class="window-bar"><i></i><i></i><i></i><span>{shotUrl}</span></div>
        <img src={shot} alt={shotAlt} width="1600" height={id === 'overlays' || id === 'pliki' || id === 'chat' || id === 'fpsblindtest' ? 900 : 1000} fetchpriority="high" />
      </div>
    )}

    {id === 'faceitLayouts' && (
      <>
        <div class="sect-head"><h2>{lang === 'pl' ? 'Układy solo' : 'Solo layouts'}</h2><small>18</small></div>
        <div class="gallery"><img src="/img/faceit-solo.webp" alt={lang === 'pl' ? 'Galeria układów solo FACEIT Banner Studio' : 'Gallery of FACEIT Banner Studio solo layouts'} width="1600" height="1100" loading="lazy" /></div>
        <div class="pills">{page.layoutGroups?.[0]?.items.map((n) => <span>{n}</span>)}</div>
        <div class="sect-head"><h2>VERSUS</h2><small>13</small></div>
        <div class="gallery"><img src="/img/faceit-versus.webp" alt={lang === 'pl' ? 'Galeria układów VERSUS FACEIT Banner Studio' : 'Gallery of FACEIT Banner Studio VERSUS layouts'} width="1600" height="550" loading="lazy" /></div>
        <div class="pills">{page.layoutGroups?.[1]?.items.map((n) => <span>{n}</span>)}</div>
      </>
    )}

    {id === 'lolLayouts' && (
      <>
        <div class="sect-head"><h2>{lang === 'pl' ? 'Wszystkie układy' : 'All layouts'}</h2><small>8</small></div>
        <div class="layouts">
          {LOL_LAYOUT_META.map((m) => (
            <a class="lay" href={`${TOOL_URL.lol}?style=${m.id}`} rel="noopener">
              <img src={`/img/lol-${m.id}.webp`} alt={m.name} width="900" height="480" loading="lazy" />
              <div><strong>{m.name}</strong><span>{m[lang]} · {m.size}</span></div>
            </a>
          ))}
        </div>
      </>
    )}

    {page.sections && (
      <div class="panel" style="margin-top:28px">
        {page.sections.map((s) => (
          <>
            <h2>{s.h2}</h2>
            {s.p?.map((t) => <p>{t}</p>)}
            {s.ul && <ul>{s.ul.map((t) => <li>{t}</li>)}</ul>}
            {s.ol && <ol class="steps">{s.ol.map((t) => <li><span>{t}</span></li>)}</ol>}
          </>
        ))}
      </div>
    )}

    {(id === 'obsGuide' || id === 'browserSource' || id === 'streamlabs') && <Recommend lang={lang} />}

    {page.faq && (
      <section class="panel faq faq-panel">
        <h2>{ui.faqTitle}</h2>
        {page.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    {page.related && (
      <>
        <p class="sec-label">{ui.relatedTitle}</p>
        <div class="related">
          {page.related.map((r) => <a href={urlFor(r, lang)}>{PAGES[lang][r].h1}</a>)}
        </div>
      </>
    )}
  </article>
</Base>
