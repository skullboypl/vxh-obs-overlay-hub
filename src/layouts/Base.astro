---
import '../styles/global.css';
import Socials from '../components/Socials.astro';
import { SITE, UI, TOOL_URL, LINKS, PROMO, REPO, SMOOTHWIZARD, urlFor, type Lang, type PageId } from '../content';
interface Props { lang: Lang; id: PageId; title: string; description: string; crumb: string; jsonLd?: object[]; }
const { lang, id, title, description, crumb, jsonLd = [] } = Astro.props;
const ui = UI[lang];
const canonical = SITE + urlFor(id, lang);
const og = SITE + '/img/og.png';
const theme = id.startsWith('faceit') ? 't-faceit' : id.startsWith('lol') ? 't-lol' : '';
const ld = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'VXH – Visual eXtras Hub', url: SITE + '/', logo: SITE + '/logo.png', sameAs: LINKS.socials.map((x) => x.url) },
  ...jsonLd,
];
const P = PROMO[lang];
const SW = SMOOTHWIZARD[lang];
const L = {
  pl: { guides: 'Poradniki OBS', home: 'Strona główna', overview: 'Przegląd', layouts: 'Układy', gen: 'Otwórz generator', menu: 'Menu' },
  en: { guides: 'OBS guides', home: 'Home', overview: 'Overview', layouts: 'Layouts', gen: 'Open generator', menu: 'Menu' },
}[lang];
type NavItem = { id?: PageId; href?: string; label: string; ext?: boolean };
type NavNode = { key: string; label: string; dot?: string; items?: NavItem[]; id?: PageId };
const nav: NavNode[] = [
  { key: 'home', id: 'home', label: L.home },
  { key: 'faceit', label: ui.nav.faceit, dot: '#ff5900', items: [
    { id: 'faceit', label: L.overview },
    { id: 'faceitLayouts', label: L.layouts },
    { href: TOOL_URL.faceit, label: L.gen, ext: true },
  ] },
  { key: 'lol', label: ui.nav.lol, dot: '#eb3d4d', items: [
    { id: 'lol', label: L.overview },
    { id: 'lolLayouts', label: L.layouts },
    { href: TOOL_URL.lol, label: L.gen, ext: true },
  ] },
  { key: 'obs', label: L.guides, items: [
    { id: 'obsGuide', label: 'OBS Studio' },
    { id: 'streamlabs', label: 'Streamlabs' },
    { id: 'browserSource', label: 'Browser Source' },
  ] },
  { key: 'faq', id: 'faq', label: ui.nav.faq },
  { key: 'about', id: 'about', label: ui.nav.about },
];
const here = nav.find((n) => n.items?.some((it) => it.id === id));
const arrow = 'M7 17 17 7M8 7h9v9';
---
<!doctype html>
<html lang={ui.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b0b0c" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="pl" href={SITE + urlFor(id, 'pl')} />
  <link rel="alternate" hreflang="en" href={SITE + urlFor(id, 'en')} />
  <link rel="alternate" hreflang="x-default" href={SITE + urlFor(id, 'pl')} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="VXH – Visual eXtras Hub" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body class={theme}>
  <a class="skip" href="#main">{ui.skip}</a>
  <header class="sidebar" id="sidebar">
    <a class="brand" href={urlFor('home', lang)} aria-label="VXH – Visual eXtras Hub">
      <img src="/logo.svg" alt="" width="42" height="42" />
      <span><b>VXH</b><span class="brand-subtitle">VISUAL EXTRAS HUB</span></span>
    </a>
    <nav class="docs-nav" aria-label={L.menu}>
      {nav.map((n) => n.items ? (
        <details class="nav-sec" name="nav" open={n.items.some((it) => it.id === id)}>
          <summary>
            {n.dot && <i class="dot" style={`--dot:${n.dot}`}></i>}<span>{n.label}</span>
            <svg class="icon chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </summary>
          <div class="nav-sub">
            {n.items.map((it) => it.ext
              ? <a class="ext" href={it.href} target="_blank" rel="noopener">{it.label}<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></a>
              : <a href={urlFor(it.id!, lang)} aria-current={it.id === id ? 'page' : undefined}>{it.label}</a>)}
          </div>
        </details>
      ) : (
        <a class="nav-top" href={urlFor(n.id!, lang)} aria-current={n.id === id ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="nav-fps" href={SMOOTHWIZARD.url} target="_blank" rel="noopener">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
        <span>{SW.menu}</span>
        <svg class="icon ext-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
      </a>
    </nav>
    <div class="side-promo">
      <a class="cta" href={LINKS.services} rel="noopener">{P.services}</a>
      <a class="cta alt donate" href={LINKS.donate} rel="noopener" aria-label={P.donate}>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>{P.donateShort}
      </a>
    </div>
  </header>

  <div class="workspace">
    <div class="topbar">
      <span class="topbar-l">
        <button class="menu-btn" id="menu-btn" type="button" aria-label={L.menu} aria-controls="sidebar" aria-expanded="false">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <span><a href={urlFor('home', lang)}>VXH</a>{here && id !== 'home' && (<><span class="divider">/</span><a href={urlFor(here.items![0].id!, lang)}>{here.label}</a></>)}{id !== 'home' && (<><span class="divider">/</span><strong>{crumb}</strong></>)}</span>
      </span>
      <span class="topbar-actions">
        <span class="seg" role="group" aria-label="Language">
          {lang === 'pl' ? <span>PL</span> : <a href={urlFor(id, 'pl')} hreflang="pl" lang="pl">PL</a>}
          {lang === 'en' ? <span>EN</span> : <a href={urlFor(id, 'en')} hreflang="en" lang="en">EN</a>}
        </span>
        <span class="obs-tag"><i></i>OBS · STREAMLABS</span>
      </span>
    </div>
    <main id="main"><slot />
      <section class="promo" aria-label={P.sideTitle}>
        <div class="promo-col">
          <h2>{P.title}</h2>
          <p>{P.text}</p>
          <a class="cta" href={LINKS.services} rel="noopener">{P.services}</a>
        </div>
        <div class="promo-col">
          <h2>{P.donateTitle}</h2>
          <p>{P.donateText}</p>
          <a class="cta alt" href={LINKS.donate} rel="noopener">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>{P.donate}
          </a>
        </div>
      </section>
    </main>
    <footer class="site">
      <Socials class="foot" />
      <p class="foot-links">
        <a href={REPO} rel="noopener" target="_blank">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          {lang === 'pl' ? 'Kod źródłowy tej strony na GitHubie' : 'Source code of this site on GitHub'}
        </a>
      </p>
      <small>{ui.footerLegal}</small>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var b = document.getElementById('menu-btn');
      if (b) {
        b.addEventListener('click', function () {
          var o = document.body.classList.toggle('nav-open');
          b.setAttribute('aria-expanded', String(o));
        });
        document.getElementById('main').addEventListener('click', function () {
          document.body.classList.remove('nav-open');
          b.setAttribute('aria-expanded', 'false');
        });
      }
      var s = document.querySelector('.hero-shots');
      if (s && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(hover: hover)').matches) {
        var raf = 0;
        s.addEventListener('pointermove', function (e) {
          var r = s.getBoundingClientRect();
          var x = (e.clientX - r.left) / r.width - 0.5;
          var y = (e.clientY - r.top) / r.height - 0.5;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(function () {
            s.style.setProperty('--mx', x.toFixed(3));
            s.style.setProperty('--my', y.toFixed(3));
          });
        });
        s.addEventListener('pointerleave', function () {
          s.style.setProperty('--mx', 0);
          s.style.setProperty('--my', 0);
        });
      }
    })();
  </script>
</body>
</html>
